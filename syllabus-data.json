            "Top-Down Parsing (LL(1)) & Bottom-Up Parsing (LR(0), SLR(1), LALR(1), CLR(1))"
          ]
        },
        {
          "name": "Syntax Directed Translation & Intermediate Code",
          "topics": [
            "Syntax-Directed Translation (SDT) & Attributes (S-attributed, L-attributed)",
            "Intermediate Code Generation (Three-Address Code, DAGs)",
            "Runtime Environments & Activation Records"
          ]
        },
        {
          "name": "Code Optimization & Data Flow Analysis",
          "topics": [
            "Local Optimization & Basic Blocks",
            "Data Flow Analysis: Constant Propagation, Liveness Analysis",
            "Common Subexpression Elimination"
          ]
        }
      ]
    },
    {
      "id": "os",
      "code": "CS-08",
      "name": "Operating Systems",
      "icon": "🖥️",
      "weightage": "8-10%",
      "color": "#F43F5E",
