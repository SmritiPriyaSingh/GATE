            "Classical Synchronization Problems (Producer-Consumer, Dining Philosophers)"
          ]
        },
        {
          "name": "Deadlock & CPU Scheduling",
          "topics": [
            "Deadlock Characterization, Prevention, Avoidance (Banker's Algorithm), Detection",
            "CPU Scheduling Algorithms (FCFS, SJF, SRTF, Round Robin, Priority)"
          ]
        },
        {
          "name": "Memory & Storage Management",
          "topics": [
            "Memory Management: Paging, Segmentation, Page Tables",
            "Virtual Memory: Page Replacement Algorithms (FIFO, LRU, Optimal)",
            "I/O Scheduling & Disk Scheduling Algorithms",
            "File System Implementation & Directory Structures"
          ]
        }
      ]
    },
    {
      "id": "dbms",
      "code": "CS-09",
