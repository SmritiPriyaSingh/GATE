        {
          "name": "C Programming & Recursion",
          "topics": [
            "C Programming Constructs, Pointers, Arrays, Structs",
            "Recursion and Call Stack Analysis"
          ]
        },
        {
          "name": "Linear Data Structures",
          "topics": [
            "Arrays, Dynamic Allocation",
            "Stacks and Queues (Array & Linked List implementation)",
            "Linked Lists: Singly, Doubly, Circular"
          ]
        },
        {
          "name": "Non-Linear Data Structures",
          "topics": [
            "Trees: Binary Trees, Traversals (Pre/In/Post)",
            "Binary Search Trees (BST) & Operations",
            "Binary Heaps & Priority Queues",
            "Graph Representations (Adjacency Matrix & List)"
          ]
        }
      ]
    },
    {
      "id": "algo",
      "code": "CS-05",
