            "Regular Expressions & Regular Grammars",
            "Pumping Lemma for Regular Languages"
          ]
        },
        {
          "name": "Context-Free Languages & Pushdown Automata",
          "topics": [
            "Context-Free Grammars (CFG) & Parsing",
            "Pushdown Automata (PDA)",
            "Closure Properties & Pumping Lemma for CFLs"
          ]
        },
        {
          "name": "Turing Machines & Undecidability",
          "topics": [
            "Turing Machines (TM) & Recursively Enumerable Sets",
            "Halting Problem & Undecidability Theory",
            "Rice's Theorem and Reduction"
          ]
        }
      ]
    },
    {
      "id": "cd",
      "code": "CS-07",
      "name": "Compiler Design",
      "icon": "🛠️",
      "weightage": "4-6%",
      "color": "#14B8A6",
      "units": [
        {
          "name": "Lexical Analysis & Parsing",
          "topics": [
