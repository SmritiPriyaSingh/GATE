        {
          "name": "Machine Instructions & Control Unit",
          "topics": [
            "Instruction Set Architecture & Addressing Modes",
            "Design of Arithmetic and Logic Unit (ALU)",
            "Control Unit Design: Hardwired vs Microprogrammed"
          ]
        },
        {
          "name": "Memory Hierarchy & I/O",
          "topics": [
            "Memory Hierarchy & Performance Metrics",
            "Cache Memory: Direct, Set-Associative, Fully Associative Mapping",
            "Cache Replacement Policies & Write Policies",
            "I/O Interface: Interrupts and Direct Memory Access (DMA)"
          ]
        },
        {
          "name": "Pipelining",
          "topics": [
            "Instruction Pipelining & Throughput",
            "Pipeline Hazards: Structural, Data, and Control Hazards"
          ]
        }
      ]
    },
    {
      "id": "pds",
      "code": "CS-04",
