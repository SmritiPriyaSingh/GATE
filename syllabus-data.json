      "weightage": "5-6%",
      "color": "#10B981",
      "units": [
        {
          "name": "Boolean Algebra & Minimization",
          "topics": [
            "Boolean Algebra Laws and Simplification",
            "Karnaugh Maps (K-Maps)",
            "Tabular Method (Quine-McCluskey)"
          ]
        },
        {
          "name": "Combinational & Sequential Circuits",
          "topics": [
            "Combinational Circuits: Adders, Subtractors, MUX, Decoders, Encoders",
            "Sequential Circuits: Latches, Flip-Flops (SR, JK, D, T)",
            "Registers, Counters (Asynchronous & Synchronous)"
          ]
        },
        {
          "name": "Number Representation",
          "topics": [
            "Fixed Point & Floating Point Representation (IEEE 754)",
            "Computer Arithmetic (Addition, Subtraction, Booth's Algorithm)"
          ]
        }
      ]
    },
    {
