      "icon": "⚡",
      "weightage": "8-10%",
      "color": "#8B5CF6",
      "units": [
        {
          "name": "Complexity Analysis & Searching/Sorting",
          "topics": [
            "Asymptotic Notation (Big-O, Omega, Theta)",
            "Worst Case Time & Space Complexity",
            "Searching & Sorting Algorithms (Quick, Merge, Heap Sort)",
            "Hashing & Collision Resolution Techniques"
          ]
        },
        {
          "name": "Algorithm Design Techniques",
          "topics": [
            "Greedy Algorithms (Fractional Knapsack, Huffman Coding)",
            "Dynamic Programming (0/1 Knapsack, LCS, Matrix Chain)",
            "Divide-and-Conquer Paradigm"
          ]
        },
        {
          "name": "Graph Algorithms",
          "topics": [
            "Graph Traversals: BFS and DFS",
            "Minimum Spanning Trees (Kruskal & Prim)",
            "Shortest Paths (Dijkstra, Bellman-Ford, Floyd-Warshall)"
          ]
        }
      ]
    },
    {
      "id": "toc",
      "code": "CS-06",
      "name": "Theory of Computation",
      "icon": "⚙️",
      "weightage": "7-9%",
      "color": "#3B82F6",
      "units": [
        {
          "name": "Automata & Regular Languages",
          "topics": [
